root = true

[*]
indent_style = space
indent_size = 2
insert_final_newline = true
max_line_length = 120

[*.go]
indent_style = tab

[{Makefile,go.mod,go.sum}]
indent_style = tab

# markdownlint (MD013) and yamllint both allow 200; matching them keeps an editor
# and the linters from disagreeing about the same line.
[*.{md,yml,yaml}]
max_line_length = 200

# Generated: license texts quoted verbatim, and the findings store's
# one-record-per-line ledger and index. Nobody wraps or reindents these by hand.
[{THIRD_PARTY_NOTICES.md,docs/audit/findings/**}]
max_line_length = off
indent_size = unset
